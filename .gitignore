# Upstream checkouts and toolchains -- huge, fetched by build.ps1 sync, never vendored.
/depot_tools/
/upstream/
/src/
/.gclient
/.gclient_entries
/.gcs_entries
/.cipd/
# depot_tools' fetch.bat creates a randomly-named scratch dir at the repo
# root while cloning (e.g. _gclient_src_6i6m77dp/), then renames it to
# src/ on success -- never left behind after a clean fetch, but visible
# (and easy to `git add .` by accident) while a fetch is in progress or if
# one was interrupted.
/_gclient_*/
# gclient's quarantine dir for dependencies whose SCM type doesn't match
# what DEPS expects -- part of its own working state, not ours.
/_bad_scm/
/.gclient_previous_sync_commits

# Generated build artifacts -- reproducible from build.ps1; keep directory
# structure (via .gitkeep) but not contents.
/build/*
!/build/.gitkeep
!/build/audit.json
/build/logs/
/build/current-overlay.txt

# Packaged releases -- large binaries; distribute via GitHub Releases if
# you want them off this machine, don't commit them to git history.
/releases/*
!/releases/.gitkeep

# Local benchmark inputs (e.g. a cloned Speedometer checkout)
/benchmarks/speedometer/

# Misc
*.log
*.pdb
*.exe
*.dll
*.7z
Thumbs.db
.vs/
