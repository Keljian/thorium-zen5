# Profile: zen5 -- AMD Ryzen 9 9950X (Zen 5), Windows x64, STOCK CHROMIUM.
#
# use_znver5 is an argument THIS PROJECT adds to Chromium (see
# patches/zen5 and scripts/apply_zen5_patches.py). Stock Chromium has no
# microarchitecture-targeting arg at all: it builds a generic x86-64
# baseline. Setting this emits -march=znver5 -mtune=znver5 for the x64
# Windows compile and, critically, for the ThinLTO backend's codegen and
# scheduling -- letting Clang's own znver5 model select the complete ISA
# (including AVX512VNNI/VBMI/VBMI2/BITALG/VPOPCNTDQ/IFMA/BF16, GFNI, VAES,
# VPCLMULQDQ) and Zen 5 scheduling, rather than a hand-maintained flag list.
#
# Backward CPU compatibility is explicitly NOT a goal: a binary built this
# way will fault with an illegal instruction on any pre-Zen5 machine.

use_znver5 = true
use_generic_avx512 = false
