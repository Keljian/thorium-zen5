# Profile: zen5 -- AMD Ryzen 9 9950X (Zen 5), Windows x64, STOCK CHROMIUM.
#
# use_znver5, zen5_march and zen5_mtune are arguments THIS PROJECT adds to
# Chromium (see patches/zen5 and scripts/apply_zen5_patches.py). Stock
# Chromium has no microarchitecture-targeting arg at all: it builds a
# generic x86-64 baseline.
#
# This emits -march=znver5 for the x64 Windows compile, letting Clang's own
# znver5 model select the complete ISA -- AVX512VNNI/VBMI/VBMI2/BITALG/
# VPOPCNTDQ/IFMA/BF16, GFNI, VAES, VPCLMULQDQ -- rather than a
# hand-maintained feature flag list.
#
# Backward CPU compatibility is explicitly NOT a goal: a binary built this
# way will fault with an illegal instruction on any pre-Zen5 machine.
#
# ZEN 5 SCHEDULING IS ON, VIA A TAIL-MERGE WORKAROUND
# ---------------------------------------------------
# -mtune=znver4/znver5 MISCOMPILES under ThinLTO on this toolchain, producing
#     lld-link: error: <unknown>:0: Missing .seh_endepilogue in <fn>
# plus ~20 symbols dropped through whole-program-devirtualization branch
# funnels. It is a SCHEDULER-triggered bug, not an ISA one: holding the
# instruction set fixed and varying only -mtune reproduces it exactly, and
# keeping -mtune=znver4 while disabling EVERY AVX-512 extension still fails.
#
# This is llvm/llvm-project#199290 -- "[WinEH] Branch folding can lead to
# `Missing .seh_endepilogue` error", confirmed upstream, whose own reduced
# reproducer uses `llc -mcpu=znver3`. Root cause per that issue: the
# block-placement pass folds tails containing SEH_EndEpilogue, orphaning the
# matching SEH_BeginEpilogue. A different scheduling model changes which
# tails are foldable, which is why it looks like an AMD-tuning bug.
#
# Verified against that diagnosis on the root_store_tool canary, -mtune=znver5
# throughout, ThinLTO cache cleared each time (-mllvm flags are NOT in the
# cache key):
#
#     (no workaround)                          FAIL
#     -mllvm:-enable-tail-merge=false          PASS   <- shipped
#     -mllvm:-disable-tail-duplicate           PASS
#     -mllvm:-disable-block-placement          PASS
#
# All three avoid it; tail-merge is the right one to give up:
#   * it is the direct match to the diagnosed cause (tail folding);
#   * tail MERGING is chiefly a code-SIZE optimization, and disabling it can
#     marginally help speed (fewer shared tails, less converged control flow),
#     so the cost is binary size;
#   * tail DUPLICATION and block PLACEMENT are both speed optimizations, and
#     disabling either would trade away more performance than the Zen 5
#     scheduling model we are buying back.
#
# So we keep the full Zen 5 ISA *and* the Zen 5 scheduling model, and pay in
# binary size only. Drop the ldflag and this reverts to a hard link error --
# never a silent miscompile.
#
# CAVEAT, recorded honestly: the in-directory control run for this specific
# comparison was invalidated (its build was interrupted mid-flight and exited
# without the real failure signature). The FAIL row above is therefore carried
# from three earlier matrices that all reproduced -mtune=znver5 failing, not
# from a same-run A/B. Re-run it if you want a clean control.
#
# Upstream status: still reproduces on a trunk clang roll ~4,000 commits newer
# (llvmorg-24-init-7747-g62397f8b), so do not expect this to age out soon.
# Our findings are attached to the upstream issue.

# ThinLTO backend knobs, appended after Chromium's own values.
#
# Chromium already passes -mllvm:-import-instr-limit=30 and /opt:lldlto=2 on
# every link. Both of ours come later on the command line and win: LLVM's
# cl::opt takes the last occurrence and lld takes the last /opt:lldlto.
# Verified against this checkout's own lld-link by passing each option twice --
# both links exited 0 with no diagnostic, so these override rather than
# conflict.
#
#   import-instr-limit=100  more cross-module inlining than Chromium's 30,
#                           which is set for BUILD TIME on a fleet, not for
#                           single-machine throughput. Paid for in link time
#                           and binary size.
#   /opt:lldlto=3           LTO codegen optimization level, up from 2.
#
# UNMEASURED. Both are plausible wins and neither is established here; treat
# the numbers in docs/BENCHMARKS.md as the authority once they exist. If they
# do not pay, delete these two lines -- there is no other coupling.
#
# WARNING: -mllvm flags are NOT part of LLVM's ThinLTO cache key. After
# changing these, delete out/thorium-zen5/thinlto-cache or the link silently
# reuses the previous codegen and the A/B measures nothing.
zen5_extra_target_ldflags = [
  "-mllvm:-enable-tail-merge=false",
  "-mllvm:-import-instr-limit=100",
  "/opt:lldlto=3",
]

# The ThinLTO backend -march flag is a NO-OP. Measured, not assumed.
#
# -march and -mcpu are different LLVM options. --march=<string> is
# "Architecture to generate code for", from CommandFlags.cpp; --mcpu=<cpu-name>
# is the one that names a processor. lld's LTO config takes its CPU from -mcpu
# and never reads -march. Probed against this checkout's own linker:
#
#   lld-link ... -mllvm:-march=bogus123   -> exit 0, no diagnostic at all
#   lld-link ... -mllvm:-mcpu=bogus123    -> "'bogus123' is not a recognized
#                                             processor for this target"
#
# An invalid -mcpu is caught; an invalid -march is not even looked at. The flag
# never did anything, which cost nothing, because the per-function target-cpu
# attributes clang bakes into the bitcode are what the ThinLTO backend actually
# honours -- that is why the ISA report shows 331,405 ZMM instructions with
# this flag doing nothing at all.
#
# Turned off because a flag that is silently ignored, in a position that is NOT
# part of the ThinLTO cache key, is exactly how this project previously reached
# two wrong conclusions about its own toolchain.
#
# Do not "fix" it by switching to -mllvm:-mcpu=znver5: that would reapply Zen
# scheduling across the whole LTO backend, which is the trigger for
# llvm#199290, and the cflags already set tune-cpu per function.
zen5_lto_backend_march = false

# These two are pinned explicitly rather than left to the declare_args
# defaults so that args.gn records what was actually built, and so
# verify-source.ps1 can assert them.

use_znver5 = true
use_generic_avx512 = false

zen5_march = "znver5"
zen5_mtune = "znver5"

# SLP VECTORIZER CAPPED AT 256 BITS
# ---------------------------------
# A THIRD toolchain bug, and this one is not AMD-specific: clang 24's X86
# backend cannot select `v4i64 = zero_extend_vector_inreg` when 512-bit
# vectors are enabled, and aborts instruction selection:
#
#   LLVM ERROR: Cannot select: v4i64 = zero_extend_vector_inreg
#   In function: SkPathRawShapes::RRect::RRect(...)
#
# Reproduced in seconds by compiling that one Skia file. The trigger is
# 512-bit codegen generally -- -mavx512f alone is enough, and
# -march=skylake-avx512 or -march=x86-64-v4 crash identically. An Intel
# AVX-512 build of Chromium would hit this too.
#
# Narrowed to the SLP vectorizer specifically, by elimination:
#     -fno-vectorize      (loop vectorizer OFF, SLP on)  -> still crashes
#     -fno-slp-vectorize  (SLP OFF, loop vectorizer on)  -> FIXED
#     -mllvm -slp-max-reg-size=256                       -> FIXED
#
# This is why the fix is an SLP register cap and NOT -mprefer-vector-width.
# Measured on a file containing both an _mm512_fmadd_ps intrinsic and an
# auto-vectorizable loop:
#
#     unrestricted 512-bit (crashes)      zmm 38   ymm  8
#     slp-max-reg-size=256  (shipped)     zmm 38   ymm  8   <- identical
#     prefer-vector-width=256             zmm  6   ymm 32   <- 85% of the
#                                                              512-bit code
#                                                              thrown away
#
# So this costs nothing measurable: loop vectorization and explicit
# intrinsics keep full 512-bit width; only straight-line SLP vectorization
# is capped, and 512-bit SLP is rare and rarely profitable anyway.
#
# Applied as an LDFLAG (see apply_zen5_patches.py): the vectorizers run in
# the ThinLTO backend, post-link, so a cflag never reaches them.
#
# WARNING: -mllvm flags are NOT part of LLVM's ThinLTO cache key. After
# changing this, delete out/thorium-zen5/thinlto-cache or the link will
# silently reuse the old codegen and appear unchanged.
#
# Set to "" once LLVM fixes the ISel gap. The failure is a hard link error.

zen5_slp_max_reg_size = "256"
