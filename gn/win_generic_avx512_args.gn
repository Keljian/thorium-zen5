# Profile: generic-avx512 -- the comparison point for the zen5 profile.
#
# Enables AVX-512 using only the "least common denominator" feature set
# common to all AVX-512 parts (F/CD/VL/BW/DQ) with a generic AVX-512
# scheduling model, i.e. what a vendor-neutral AVX-512 build looks like.
# This is deliberately what Thorium's own AVX-512 flavor did before this
# project stopped overlaying it, so the zen5-vs-generic ISA and benchmark
# comparison stays meaningful.
#
# Exists so `scripts/compare_builds.py` can answer "did targeting znver5
# specifically actually buy anything over generic AVX-512" with measured
# numbers rather than assertion.

use_znver5 = false
use_generic_avx512 = true
