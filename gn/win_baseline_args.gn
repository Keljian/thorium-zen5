# Profile: baseline -- completely unmodified stock Chromium.
#
# Neither of this project's CPU-targeting args is set, so the tree is built
# exactly as upstream ships it (generic x86-64 baseline, SSE3-era). No zen5
# patches are applied to the source for this profile at all -- build.ps1
# configure skips them -- so this is a true reference point for
# scripts/compare_builds.py on binary size, ISA content and benchmarks.

use_znver5 = false
use_generic_avx512 = false
